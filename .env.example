# Optional Stable Audio 3 provider (disabled by default)
STABLE_AUDIO_ENABLED=false
STABLE_AUDIO_PROVIDER=modal
STABLE_AUDIO_MODAL_URL=
STABLE_AUDIO_API_KEY=
STABLE_AUDIO_MODEL=small-music
STABLE_AUDIO_DEFAULT_DURATION=30
STABLE_AUDIO_TIMEOUT=600
STABLE_AUDIO_MAX_DURATION=120
STABLE_AUDIO_MAX_RETRIES=1
STABLE_AUDIO_MAX_UPLOAD_BYTES=33554432

# This deployment uses CPU-only Small Music; leave optional GPU fields empty.
STABLE_AUDIO_GPU=
STABLE_AUDIO_GPU_MEMORY=
STABLE_AUDIO_CPU=4
STABLE_AUDIO_MEMORY=8192
STABLE_AUDIO_IDLE_TIMEOUT=60
STABLE_AUDIO_HF_SECRET=huggingface-token

# Optional YuE2 Modal GPU service (disabled by default).
# Model weights are CC BY-NC 4.0 with additional creator terms.
# Personal/noncommercial use only unless separately licensed.
YUE2_ENABLED=false
YUE2_MODAL_URL=
YUE2_API_KEY=
YUE2_MODEL=yue2-music
YUE2_DEFAULT_DURATION=180
YUE2_TIMEOUT=1800
YUE2_MAX_DURATION=600
YUE2_MAX_RETRIES=0
YUE2_GPU=L40S
YUE2_CPU=8
YUE2_MEMORY=32768
YUE2_IDLE_TIMEOUT=300

# Optional ACE-Step 1.5 Modal GPU service (disabled by default).
ACESTEP_ENABLED=false
ACESTEP_MODAL_URL=
ACESTEP_API_KEY=
ACESTEP_MODEL=acestep-1.5
ACESTEP_DEFAULT_DURATION=30
ACESTEP_TIMEOUT=1800
ACESTEP_MAX_DURATION=600
ACESTEP_MAX_RETRIES=0
ACESTEP_GPU=L40S
ACESTEP_CPU=8
ACESTEP_MEMORY=32768
ACESTEP_IDLE_TIMEOUT=300
ACESTEP_LM_MODEL=acestep-5Hz-lm-0.6B
